{
	"rewrites": [
		{
			"source": "/",
			"destination": "/api/index"
		},
		{
			"source": "/activity",
			"destination": "/api/index?page=activity"
		},
		{
			"source": "/message",
			"destination": "/message.html"
		}
	],
	"headers": [
		{
			"source": "/vendor/(.*)",
			"headers": [
				{
					"key": "Content-Type",
					"value": "text/javascript; charset=utf-8"
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	],
	"functions": {
		"api/index.ts": {
			"maxDuration": 10,
			"includeFiles": "src/**"
		},
		"api/interactions.ts": {
			"maxDuration": 15,
			"includeFiles": "src/**"
		},
		"api/discord-events.ts": {
			"maxDuration": 15,
			"includeFiles": "src/**"
		},
		"api/diag.ts": {
			"maxDuration": 15,
			"includeFiles": "src/**"
		},
		"api/message.ts": {
			"maxDuration": 15,
			"includeFiles": "src/**"
		},
		"api/activity.ts": {
			"maxDuration": 10,
			"includeFiles": "src/**"
		},
		"api/discord-oauth-callback.ts": {
			"maxDuration": 10,
			"includeFiles": "src/**"
		}
	},
	"installCommand": "npm install",
	"buildCommand": "npm run build && npm run register:deploy"
}
