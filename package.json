{
	"name": "@minesa-org/mini-app",
	"version": "2.0.1",
	"description": "Mini-Interaction <3 — app template on the modular router stack.",
	"type": "module",
	"main": "api/interactions.ts",
	"scripts": {
		"build": "tsc --noEmit",
		"mi-latest": "npm i \"git+https://github.com/minesa-org/mini-interaction.git#v0.14.0\"",
		"register": "tsx scripts/register.ts",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test $(find src -name '*.test.ts' -type f)"
	},
	"keywords": [
		"discord",
		"app",
		"template",
		"http-interaction"
	],
	"author": "Minesa",
	"license": "MIT",
	"dependencies": {
		"@minesa-org/mini-interaction": "github:minesa-org/mini-interaction#v0.14.0",
		"dotenv": "^17.2.3",
		"mongodb": "^7.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.10.0",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3"
	}
}
