{
	"name": "@minesa-org/mini-app",
	"version": "2.0.1",
	"description": "Mini-Interaction <3 — app template on the modular router stack.",
	"type": "module",
	"main": "api/interactions.ts",
	"scripts": {
		"build": "tsc --noEmit",
		"mi-vendor": "node scripts/vendor-mini-interaction.mjs",
		"activity-vendor": "node scripts/vendor-activity-sdk.mjs",
		"register": "tsx scripts/register.ts",
		"register:deploy": "tsx scripts/register-deploy.ts",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test $(find src -name '*.test.ts' -type f)"
	},
	"keywords": [
		"discord",
		"app",
		"template",
		"http-interaction"
	],
	"author": "Minesa",
	"license": "MIT",
	"dependencies": {
		"@discord/embedded-app-sdk": "^2.5.0",
		"@minesa-org/mini-interaction": "file:vendor/mini-interaction-0.14.0.tgz",
		"dotenv": "^17.2.3",
		"mongodb": "^7.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.10.0",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3"
	}
}
