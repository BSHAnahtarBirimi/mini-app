# Copy this file to `.env` and fill in the values.

# Discord application credentials (https://discord.com/developers/applications)
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# OAuth2 (required for the linked-roles connect flow)
DISCORD_CLIENT_SECRET=
# e.g. https://your-app.vercel.app/api/discord-oauth-callback
DISCORD_REDIRECT_URI=

# Optional: set to register commands on a single guild (instant updates)
DISCORD_GUILD_ID=

# MongoDB connection string used by MiniDatabase (token storage)
MONGODB_URI=
